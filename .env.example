# Copy to .env and uncomment/edit if EPICS Channel Access auto-discovery
# (UDP broadcast) doesn't reach your IOCs - e.g. across subnets, or if
# broadcasts are blocked on your network. Leave unset to let caproto
# auto-discover PVs, which is the default and usually all you need.

# EPICS_CA_AUTO_ADDR_LIST=NO
# EPICS_CA_ADDR_LIST=192.168.22.4 192.168.22.5
