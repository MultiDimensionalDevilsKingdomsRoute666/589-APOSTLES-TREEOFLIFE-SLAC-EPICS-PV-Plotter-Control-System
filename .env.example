# Copy to .env and uncomment/edit if EPICS Channel Access auto-discovery
# (UDP broadcast) doesn't reach your IOCs - e.g. across subnets, or if
# broadcasts are blocked on your network. Leave unset to let caproto
# auto-discover PVs, which is the default and usually all you need.

# EPICS_CA_AUTO_ADDR_LIST=NO
# EPICS_CA_ADDR_LIST=192.168.22.4 192.168.22.5

# Uncomment if config.json lives on an NFS-mounted home directory (common
# on shared lab/beamline servers). NFS "root-squashes" the backend
# container's root user, so it can't save config.json - run the container
# as your own host user instead. Not needed on a local disk (e.g. a
# Raspberry Pi SD card). Find your values with `id -u` / `id -g`.
# APP_UID=1000
# APP_GID=1000
